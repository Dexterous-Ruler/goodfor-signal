# Goodfor TikTok Machine — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored.
# NEVER paste real secrets into chat, tickets, or committed files.
#
# ─────────────────────────────────────────────────────────────
# WRITE PLANE — TikTok's own APIs (publishing to Goodfor accounts)
# ─────────────────────────────────────────────────────────────

# From developers.tiktok.com → Manage apps.
# The client key is a public identifier. The secret is not — rotate it
# if it is ever pasted anywhere outside a secret manager.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Must exactly match the redirect URI registered in the developer portal.
# Android requires an App Link / Deep Link; iOS a Universal Link.
TIKTOK_REDIRECT_URI=https://localhost:3000/api/auth/tiktok/callback

# Scopes to request. Only request what you demonstrably use —
# requesting unused scopes is a documented audit-rejection reason.
#   user.info.basic   — required in practice
#   video.list        — required to read your own posts
#   video.publish     — Direct Post  (audit-gated for public posts)
#   video.upload      — draft/inbox  (NOT audit-gated; the Phase 3 path)
TIKTOK_SCOPES=user.info.basic,video.list,video.upload

# TikTok API for Business — own-account insights (reach, watch time,
# impression sources). Separate credential set from the above.
# Gated behind the Accounts API Access Application Form, mandatory
# for new apps since 20 March 2026.
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_SECRET=

# ─────────────────────────────────────────────────────────────
# READ PLANE — competitor data (SEPARATE deployment, separate egress)
# These must never be loaded into the same process as the keys above.
# ─────────────────────────────────────────────────────────────

ENSEMBLEDATA_TOKEN=
SCRAPECREATORS_API_KEY=

# Apify (clockworks/free-tiktok-scraper) — the PREFERRED media source. The
# analyser fetches playable video through Apify (separate quota from
# EnsembleData's daily unit cap). apify.com → Settings → Integrations → API
# tokens. When both this and ENSEMBLEDATA_TOKEN are set, listings use
# EnsembleData (cheap bulk) and media resolves via Apify.
APIFY_TOKEN=

# ─────────────────────────────────────────────────────────────
# Infrastructure
# ─────────────────────────────────────────────────────────────

# Supabase — the service-role PostgREST client EVERY app boots with. db() THROWS
# without both of these, so an app provisioned without them 500s on boot.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (migrations + the write-plane advisory-lock RPC).
DATABASE_URL=postgresql://user:pass@host:5432/goodfor
REDIS_URL=redis://localhost:6379

# 32-byte key for envelope-encrypting OAuth tokens at rest.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
# AI
# ─────────────────────────────────────────────────────────────

GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────
# Attribution
# ─────────────────────────────────────────────────────────────

# Kochava free tier — owned-media attribution + SmartLinks ($0, 10K conv/mo).
# The billing trap: owned-media links must be confirmed to bill $0 in writing
# before any paid-tier move. Never front organic TikTok with a paid-UA link.
KOCHAVA_API_KEY=
KOCHAVA_APP_GUID=

# App Store Connect Analytics Reports API — JWT (ES256), Admin role for the
# first request of each report type. PRIVATE_KEY is the .p8 PEM; the _B64
# variant (base64 of the PEM) is accepted for single-line secret stores.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────
# Creator CRM (Phase 5 — write plane ONLY; never co-locate with read-plane keys)
# ─────────────────────────────────────────────────────────────

# Modash Discovery API — $16,200/yr floor (the barrier, not the unit cost). Do
# NOT begin integration until that floor is signed off. Capture `credibility` at
# search time; a 404 consumes a credit (never retry it).
MODASH_API_KEY=
MODASH_BASE_URL=

# HypeAuditor — Audience Quality Score. Build against the free sandbox; pin
# v=2019-10-18; throttle to 100 req/min. Pricing unpublished.
HYPEAUDITOR_API_TOKEN=
HYPEAUDITOR_BASE_URL=

# Outreach — DM is a one-shot (TikTok delivers exactly one to a non-follower),
# then the cadence is email (day 2 / day 5 / terminal day 28).
TIKTOK_DM_ACCESS_TOKEN=
OUTREACH_EMAIL_API_KEY=

# Spark Ads via TikTok Business Center account-level linking (no expiry). Codes
# cannot be reactivated — on auth_code_expired, mint a new one.
TIKTOK_BUSINESS_ACCESS_TOKEN=
